# Copy to .env and adjust. Every value has a sane default in the code, so you can
# also just leave .env empty and rely on defaults for local development.
#
# The docker-compose setup sets DATABASE_URL for you; you mainly need this file
# when running the binaries directly against your own Postgres.

# Postgres connection string.
DATABASE_URL=postgres://scheduler:scheduler@localhost:5432/taskscheduler?sslmode=disable

# API + dashboard listen address.
HTTP_ADDR=:8080

# --- Worker tuning ---
# How many tasks one worker process runs concurrently.
WORKER_CONCURRENCY=5
# Pause between polls when the last poll found no work.
POLL_INTERVAL=1s
# How often a worker updates its heartbeat.
HEARTBEAT_INTERVAL=10s
# Max time to wait for in-flight tasks on shutdown (SIGTERM).
SHUTDOWN_GRACE=30s

# --- Reaper tuning (server process) ---
# How often to scan for dead workers / stale locks.
REAPER_INTERVAL=15s
# A task 'running' longer than this with no heartbeat is presumed orphaned.
# MUST be >= 2 * HEARTBEAT_INTERVAL (the app refuses to start otherwise).
LOCK_TTL=30s
